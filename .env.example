# --- required ---
SECRET_KEY=                              # openssl rand -hex 32
ADMIN_PASSWORD=                          # strong password for the seeded admin
ANTHROPIC_API_KEY=                       # unused in P0; required from P2

# --- database ---
POSTGRES_HOST=v3_pgbouncer
POSTGRES_PORT=5432
POSTGRES_DB=legalrag
POSTGRES_USER=legalrag
POSTGRES_PASSWORD=legalrag

# --- redis ---
REDIS_URL=redis://v3_redis:6379/0

# --- minio ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=legalrag
S3_SECRET_KEY=legalrag-secret
S3_BUCKET_UPLOADS=v3-uploads
S3_BUCKET_DEBUG=v3-ingestion-debug

# --- TEI ---
TEI_EMBED_URL=http://v3_tei_embed:80
TEI_RERANK_URL=http://v3_tei_rerank:80

# --- models / rule 1 invariant ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- observability ---
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=legal-rag-v3-api
