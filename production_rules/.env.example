# Postgres (read-only user is enough)
DATABASE_URL=postgresql://rules_reader:CHANGE_ME@localhost:5432/legal_rag

# Must equal the backend's config — this is what rule 1 checks against
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
NORMALIZER_VERSION=1

# TEI embedding server (rule 1 checks the served model id)
TEI_EMBED_URL=http://localhost:8081

# Path to the v3 backend package root (folder that contains `app/`)
BACKEND_PATH=./backend

# API for rule 3 (admin token for full access; restricted token for ACL-leak test)
API_URL=http://localhost:8000
API_ADMIN_TOKEN=
API_RESTRICTED_TOKEN=
RESTRICTED_ALLOWED_COLLECTIONS=1,2
